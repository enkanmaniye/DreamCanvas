# Copy this file to .env.local. Every value is optional: with nothing set,
# DreamCanvas runs in Local Demo Mode (no accounts, no AI, saved in this browser).
# Never commit .env.local or paste these values into client-side code.

# Accounts and cloud saving (https://supabase.com, Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used only on the server, only for "Delete my account". Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# AI suggestions: choose gemini, ollama or none. Blank means gemini when a key is set.
AI_PROVIDER=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order if the main model returns 404 or is retired.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Set to true once your Google project has billing enabled. On the free tier
# Google may use submitted content to improve its products, and the app warns about that.
GEMINI_PAID_TIER=false

# Free, open-source and private: runs on your own computer (https://ollama.com)
# ollama pull qwen3-vl:4b   (a 3.3 GB download; a GPU with 6 GB or more is recommended)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b

# Openly licensed image search. No key needed.
OPENVERSE_API_BASE=https://api.openverse.org/v1

# Optional extra AI photos (FLUX.1 Schnell through an endpoint you run or rent). Off by default.
ENABLE_AI_IMAGE_GENERATION=false
IMAGE_GENERATION_API_URL=
IMAGE_GENERATION_API_KEY=
