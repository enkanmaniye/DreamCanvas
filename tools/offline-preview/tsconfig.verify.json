{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": [],
    "jsx": "react-jsx",
    "typeRoots": ["../../node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@/*": ["../../src/*"],
      "react": ["./types/react.d.ts"],
      "react/jsx-runtime": ["./types/jsx-runtime.d.ts"],
      "react-dom/client": ["./types/react-dom-client.d.ts"],
      "next": ["./types/next.d.ts"],
      "next/link": ["./types/next-link.d.ts"],
      "next/navigation": ["./types/next-navigation.d.ts"],
      "@supabase/supabase-js": ["./types/supabase.d.ts"]
    }
  },
  "include": ["../../src/**/*.ts", "../../src/**/*.tsx", "../../tests/**/*.ts", "./globals.d.ts"],
  "exclude": []
}
